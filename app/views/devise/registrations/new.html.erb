<div class="create-account-container">
  <div class="create-account-form">

    <h2>新規登録</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <p><%= f.label :name, "名前" %></p>
        <p><%= f.text_field :name, placeholder: "名前を入力" %></p>
      </div>

      <div class="field">
        <p><%= f.label :email, "メールアドレス" %></p>
        <p><%= f.email_field :email, placeholder: "メールアドレスを入力", autofocus: true, autocomplete: "email" %></p>
      </div>

      <div class="field">
        <p><%= f.label :password, "パスワード" %></p>
        <% if @minimum_password_length %>
          <p>(6文字以上で入力してください)</p>
        <% end %>
        <p><%= f.password_field :password, placeholder: "パスワードを入力", autocomplete: "new-password" %></p>
      </div>

      <div class="field">
        <p><%= f.label :password_confirmation, "確認用パスワード" %></p>
        <p><%= f.password_field :password_confirmation, placeholder: "確認用パスワードを入力", autocomplete: "new-password" %></p>
      </div>

      <div class="actions">
        <%= f.submit "新しいアカウントを作成" %>
      </div>
    <% end %>
    
    <div class="to-login">
      <%= link_to "ログイン", new_user_session_path %>
    </div>
  </div>
</div>
