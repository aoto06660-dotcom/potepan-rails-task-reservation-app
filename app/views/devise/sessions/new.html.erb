<div class="login-container">

  <div class="login-form">

    <h2>ログイン</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field">
        <p><%= f.label :email, "メールアドレス" %></p>
        <p><%= f.email_field :email, placeholder: "abc@example.com", autocomplete: "off" %></p>
      </div>

      <div class="field">
        <p><%= f.label :password, "パスワード" %></p>
        <p><%= f.password_field :password, placeholder: "パスワードを入力", autocomplete: "off" %></p>
      </div>

      <div class="actions">
        <%= f.submit "ログイン" %>
      </div>
    <% end %>
    
    <div class="login-links">
      <%= render "devise/shared/links" %>
    </div>
  
  </div>

</div>