<div class="room-form-container">

  <div class="room-form-card">

    <%= form_with model: room do |f| %>
      <% if room.errors.any? %>
        <div class="room-errors">
          <ul>
            <% room.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class= "room-form-field">
        <%= f.label :name, "施設名" %>
        <%= f.text_field :name %>
      </div>

      <div class="room-form-field">
        <%= f.label :bio, "施設詳細" %>
        <%= f.text_area :bio %>
      </div>

      <div class="room-form-field">
        <%= f.label :fee, "料金" %>
        <%= f.number_field :fee %>
      </div>

      <div class="room-form-field">
        <%= f.label :address, "住所" %>
        <%= f.text_field :address %>
      </div>

      <div class="room-form-field">
        <%= f.label :image, "施設画像" %>
        <%= f.file_field :image %>
      </div>
      
      <div class="room-form-actions">
        <p><%= f.submit "保存" %></p>
        <p><%= link_to "キャンセル", rooms_path, class: "room-form-cancel" %><p>
      </div>
    <% end %>

    <% if @room.errors.any? %>
      <div class="alert alert-danger mt-3">
        <ul class="mb-0">
          <% @room.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

  </div>

</div>
  