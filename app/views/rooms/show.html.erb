<%= render "search_form" %>

<div class="room-show-container">
 
  <%= link_to "←戻る", rooms_path, class: "room-back" %>

  <div class="room-show-content">

    <div class="room-show-image">
      <% if @room.image.attached? %>
        <%= image_tag @room.image, width: 300 %>
      <% else %>
        <%= image_tag "no_image.png", width: 400 %>
      <% end %>
    </div>

    <div class="room-show-info">
      <div class="room-show-header">
        <h2><%= @room.name %></h2>
        <p>¥<%= @room.fee %>~</p>
      </div>

      <p class="room-show-address"><%=  @room.address %></p>
      <p class="room-show-bio"><%= @room.bio %></p>
      
      <%= form_with model: @reservation,
                    url: confirm_room_reservations_path(@room),
                    method: :post,
                    data: { turbo: false },
                    class: "reservation-form" do |f| %>
        <div class="reservation-fields">
          <div class="reservation-field">
            <%= f.label :check_in, "チェックイン" %>
            <%= f.date_field :check_in %>
          </div>

          <div class="reservation-field">
            <%= f.label :check_out, "チェックアウト" %>
            <%= f.date_field :check_out %>
          </div>

          <div class="reservation-field">
            <%= f.label :guest, "人数" %>
            <%= f.number_field :guest %>
          </div>
        </div>
        
        <% if user_signed_in? %>
          <%= f.submit "予約する", class: "reservation-button" %>            
        <% else %>
          <%= link_to "ログイン",
                      new_user_session_path,
                      class: "reservation-button" %>
        <% end %>
      
      <% end %>

    </div>

  </div>

</div>
