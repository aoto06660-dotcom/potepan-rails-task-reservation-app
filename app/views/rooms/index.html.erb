<div>
  <%= form_with url: rooms_path, method: :get do |f| %>
    <%= f.text_field :address,
                      value: params[:address],
                      placeholder: "エリア名を入力" %>

    <%= f.text_field :keyword,
                      value: params[:keyword],
                      placeholder: "キーワード名を入力" %>
    <%= f.submit "検索" %>
  <% end %>
</div>

<h2><%= @rooms.count %>件が見つかりました</h2>

<% @rooms.each do |room| %>
  <div>
    <% if room.image.attached? %>
      <%= image_tag room.image, width: 200 %>
    <% end %>

    <h3><%= room.name %></h3>
    <p><%= room.address %></p>
    <p><%= room.bio %></p>
    <p>¥<%= room.fee %>~</p>

    <%= link_to "詳細はこちら", room_path(room) %>
  </div>
<% end %>


                  
