<h2>予約済み一覧</h2>

<div>
  <% @reservations.each do |reservation| %>
    <% nights = (reservation.check_out - reservation.check_in).to_i %>
    <% total_price = nights * reservation.room.fee * reservation.guest %>

  <table>
    <tr>
      <th>画像</th>
      <th>施設名</th>
      <th>紹介文</th>
      <th>合計料金</th>
      <th>チェックイン</th>
      <th>チェックアウト</th>
      <th>予約確定日時</th>
    </tr>

    <tr>
      <td><%= reservation.room.image %></td>
      <td><%= reservation.room.name %></td>
      <td><%= reservation.room.bio %></td>
      <td>¥<%= total_price %></td>
      <td><%= reservation.check_in %></td>
      <td><%= reservation.check_out %></td>
      <td><%= reservation.created_at %></td>
    </tr>
  </table>

  <% end %>
</div>
