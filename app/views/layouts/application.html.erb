<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Reservation App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    >

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
  </script>

  <body>
    <div>
      <header class="site-header">
        <h2><%= link_to "Potepan Share", home_index_path %></h2>

        <% if user_signed_in? %>
          <details class="user-menu">
            <summary>
              <% if current_user.avatar.attached? %>
                <%= image_tag current_user.avatar, width: 40 %>
              <% end %>

              <%= current_user.name %>
            </summary>

            <div class="dropdown_menu">
              <%= link_to "施設の新規登録", new_room_path %>

              <hr>

              <p><%= link_to "予約済み一覧", reservations_path %></p>
              <p><%= link_to "登録済み一覧", my_rooms_rooms_path %></p>
              <p><%= link_to "アカウント設定", account_path %></p>

              <hr>

              <%= link_to "ログアウト", 
                          destroy_user_session_path,
                          data: { turbo_method: :delete } %>
            </div>
          </details>
        <% else %>
          <ul class="navbar-nav">
            <li><%= link_to "ログイン", new_user_session_path %></li>
            <li class="new_user_button"><%= link_to "新規登録", new_user_registration_path %></li>
          </ul>
        <% end %>
      </header>
    </div>

    <main>
      <%= yield %>
    </main>
  </body>

  <footer>
    <h2><%= link_to "Potepan Share", home_index_path %></h2>
    <p>Copyright © Potepan Share 2026 All rights reserved</p>
  </footer>
</html>
