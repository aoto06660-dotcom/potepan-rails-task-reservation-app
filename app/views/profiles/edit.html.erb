<div class="container-fluid px-4 py-5">

  <div class="row g-3">

    <div class="col-md-3">
      <%= render "shared/settings_sidebar", active_menu: "profile" %>
    </div>

    <div class="col-md-9">

      <h2 class="mb-4 border-bottom pb-3 mb-4">プロフィール</h2>

      <%= form_with model: @user, url: profile_path do |f| %>

        <div class="profile-edit-row">
          <%= f.label :avatar, "アイコン画像" %>
          <%= f.file_field :avatar %>
        </div>
            
        <div class="profile-edit-row">
          <%= f.label :name, "名前" %>
          <%= f.text_field :name %>
        </div>

        <div class="profile-edit-row">
          <%= f.label :bio, "自己紹介" %>
          <%= f.text_area :bio %>
        </div>

        <div class="profile-edit-actions">
          <%= link_to "キャンセル", profile_path, class: "text-decoration-none" %>
          <%= f.submit "保存", class: "btn btn-danger" %>
        </div>
        
      <% end %>

      <% if @user.errors.any? %>
        <div class="alert alert-danger mt-3">
          <ul class="mb-0">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</div>

